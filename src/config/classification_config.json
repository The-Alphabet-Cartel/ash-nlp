{
	"_metadata": {
		"file_version": "v5.1-7-7.1-1",
		"last_modified": "2026-02-18",
		"clean_architecture": "Compliant",
		"description": "Classification behavior configuration - thresholds, figurative language gate, and scoring behavior",
		"repository": "https://github.com/the-alphabet-cartel/ash-nlp",
		"community": "The Alphabet Cartel - https://discord.gg/alphabetcartel | https://alphabetcartel.org"
	},

	"thresholds": {
		"description": "Crisis severity threshold mappings for ensemble scoring. Step 6.5: HIGH lowered from 0.70 to 0.65 based on score distribution analysis showing 14-15 definite_high failures in the 0.65-0.70 band.",
		"critical": "${NLP_THRESHOLD_CRITICAL}",
		"high": "${NLP_THRESHOLD_HIGH}",
		"medium": "${NLP_THRESHOLD_MEDIUM}",
		"low": "${NLP_THRESHOLD_LOW}",
		"defaults": {
			"critical": 0.85,
			"high": 0.65,
			"medium": 0.5,
			"low": 0.3
		},
		"validation": {
			"critical": {
				"type": "float",
				"range": [0.7, 0.99],
				"required": true
			},
			"high": {
				"type": "float",
				"range": [0.5, 0.9],
				"required": true
			},
			"medium": {
				"type": "float",
				"range": [0.3, 0.7],
				"required": true
			},
			"low": {
				"type": "float",
				"range": [0.1, 0.5],
				"required": true
			}
		}
	},

	"figurative_gate": {
		"description": "Figurative Language Gate configuration (Phase 7 - replaces Phase 6 irony gatekeeper). Zero-shot classifier that detects non-literal speech patterns (hyperbole, sarcasm, gaming death metaphors) and applies post-processing score reduction to prevent false-positive crisis classifications. Uses DeBERTa-v3-base-mnli (same model as Sentiment-ZS and Emotions-ZS).",
		"enabled": "${NLP_FIGURATIVE_GATE_ENABLED}",
		"confidence_threshold": "${NLP_FIGURATIVE_GATE_THRESHOLD}",
		"reduction_factor": "${NLP_FIGURATIVE_GATE_REDUCTION}",
		"skip_below": "${NLP_FIGURATIVE_GATE_SKIP_BELOW}",
		"defaults": {
			"enabled": true,
			"confidence_threshold": 0.75,
			"reduction_factor": 0.60,
			"skip_below": 0.30
		},
		"validation": {
			"enabled": {
				"type": "boolean",
				"required": false
			},
			"confidence_threshold": {
				"type": "float",
				"range": [0.5, 0.99],
				"required": false
			},
			"reduction_factor": {
				"type": "float",
				"range": [0.1, 1.0],
				"required": false
			},
			"skip_below": {
				"type": "float",
				"range": [0.0, 0.5],
				"required": false
			}
		}
	},

	"confidence_weighting": {
		"description": "Scale model influence by their classification confidence - high-confidence models get more say (Phase 6.2.5)",
		"enabled": "${NLP_CONFIDENCE_WEIGHTING_ENABLED}",
		"blend": "${NLP_CONFIDENCE_WEIGHTING_BLEND}",
		"defaults": {
			"enabled": true,
			"blend": 0.5
		},
		"validation": {
			"enabled": {
				"type": "boolean",
				"required": false
			},
			"blend": {
				"type": "float",
				"range": [0.0, 1.0],
				"required": false
			}
		}
	},

	"consensus_escalation": {
		"description": "Consensus disagreement severity floor (Step 6.4.3) - when consensus score significantly exceeds pipeline score, applies a severity floor to catch implicit crisis language that BART missed but contextual models detected",
		"enabled": "${NLP_CONSENSUS_ESCALATION_ENABLED}",
		"disagreement_threshold": "${NLP_CONSENSUS_ESCALATION_DISAGREEMENT_THRESHOLD}",
		"consensus_minimum_score": "${NLP_CONSENSUS_ESCALATION_MINIMUM_SCORE}",
		"drop_levels": "${NLP_CONSENSUS_ESCALATION_DROP_LEVELS}",
		"set_requires_review": "${NLP_CONSENSUS_ESCALATION_SET_REQUIRES_REVIEW}",
		"defaults": {
			"enabled": true,
			"disagreement_threshold": 0.15,
			"consensus_minimum_score": 0.40,
			"drop_levels": 0,
			"set_requires_review": true
		},
		"validation": {
			"enabled": {
				"type": "boolean",
				"required": false
			},
			"disagreement_threshold": {
				"type": "float",
				"range": [0.1, 0.9],
				"required": false
			},
			"consensus_minimum_score": {
				"type": "float",
				"range": [0.3, 0.95],
				"required": false
			},
			"drop_levels": {
				"type": "integer",
				"range": [0, 3],
				"required": false
			},
			"set_requires_review": {
				"type": "boolean",
				"required": false
			}
		}
	}
}